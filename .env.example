# === Railway WEB and WORKER ===
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
REDIS_URL=redis://USER:PASSWORD@HOST:6379
S3_ENDPOINT=https://REPLACE_WITH_RAILWAY_BUCKET_ENDPOINT
S3_BUCKET=est-uploads
S3_REGION=auto
S3_ACCESS_KEY_ID=SET_IN_RAILWAY_ONLY
S3_SECRET_ACCESS_KEY=SET_IN_RAILWAY_ONLY
S3_FORCE_PATH_STYLE=true

# === WEB service only ===
APP_PUBLIC_ORIGIN=https://your-web-service.up.railway.app
APP_PASSWORD_HASH=GENERATE_WITH_NPM_RUN_MAKE_PASSWORD
SESSION_SECRET=GENERATE_RANDOM_64_HEX_CHAR_SECRET
# Cookie auth requires HTTPS in deployment; use localhost for local dev only
MAX_ZIP_BYTES=35000000

# === WORKER service only ===
# API keys NEVER go into NEXT_PUBLIC_*, browser input fields, GitHub, or client storage
ROBLOX_OPEN_CLOUD_API_KEY_USER=SET_IN_RAILWAY_ONLY
ROBLOX_OPEN_CLOUD_API_KEY_GROUP=SET_IN_RAILWAY_ONLY
ALLOWED_ROBLOX_USER_ID=123456789
ALLOWED_ROBLOX_GROUP_ID=987654321
# Keep false until account permissions and current API request format are verified
ROBLOX_UPLOADS_ENABLED=false
ROBLOX_CREATE_ASSET_URL=https://apis.roblox.com/assets/v1/assets
ROBLOX_OPERATION_URL_PREFIX=https://apis.roblox.com/assets/v1/operations/
ROBLOX_ASSET_TYPE=Decal
ROBLOX_UPLOADS_PER_SECOND=2
